# Copy to .env at the repo root. Shared by docker compose, the web app and the workers.

POSTGRES_USER=bettermarket
POSTGRES_PASSWORD=bettermarket
POSTGRES_DB=bettermarket
DATABASE_URL=postgresql://bettermarket:bettermarket@localhost:5432/bettermarket

MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key-change-me

REDIS_URL=redis://localhost:6379/0

# Generate with: npx @better-auth/cli secret   (or any 32+ char random string)
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
