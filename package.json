{
  "name": "bettermarket",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "typecheck": "npm run typecheck -w web",
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file .env down",
    "db:generate": "npm run db:generate -w web",
    "db:migrate": "npm run db:migrate -w web",
    "db:studio": "npm run db:studio -w web"
  }
}
